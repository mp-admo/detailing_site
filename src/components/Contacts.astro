---
// Яндекс Карты: карточка организации «Нова» (Новороссийск, наб. Адмирала Серебрякова, 79Г)
// ID организации берётся из ссылки вида yandex.ru/maps/org/nova/<ID>/
const mapOrgId = "244025638356";
const mapCoords = "37.790992,44.693029"; // долгота,широта — центр карты
const mapSrc = `https://yandex.ru/map-widget/v1/org/nova/${mapOrgId}/?ll=${encodeURIComponent(mapCoords)}&z=17&lang=ru_RU`;


---

 <!-- Контакты и карта -->
		<section id="contacts" class="contacts">

			<div class="container">

				<div class="contacts__header">

				<h2 class="contacts__title">
					Бесплатная консультация
				</h2>

				<p class="contacts__text">
					Подберём оптимальное решение под ваш автомобиль, подробно расскажем о работах и сориентируем по стоимости. Позвоните или напишите в Telegram — ответим на все вопросы.
				</p>

				</div>

				<div class="contacts__content">

					<!-- Контактная информация, левый блок -->
					 <div class="contacts__info">
						
						<!-- Телефон -->
						<div class="contacts__item">

							<span class="contacts__label">
								Телефон:
							</span>

							<a href="tel:+79184641250" class="contacts__value contacts__value--accent contacts__value--phone">
								+7 (918) 464-12-50
							</a>

							<a href="tel:+79284151250" class="contacts__value contacts__value--accent contacts__value--phone">
								+7 (928) 415-12-50
							</a>

						</div>

						<!-- Режим работы -->
						<div class="contacts__item">

							<span class="contacts__label">
								Режим работы:
							</span>

							<p class="contacts__value">
								Ежедневно с 9:00 до 18:00
							</p>

						</div>

						<!-- Адрес -->
						<div class="contacts__item">

							<span class="contacts__label">
								Адрес:
							</span>

							<p class="contacts__value">
								Новороссийск, <br />
								Наб. Адмирала Серебрякова, 79Г
							</p>

						</div>



						<!-- Телеграм -->
						<div class="contacts__item">
							
							<span class="contacts__label">
							Telegram:
							</span>
							
							<a href="https://t.me/Nova_Detail" class="contacts__value contacts__value--accent contacts__value--telegram"
								target="_blank" rel="noopener noreferrer">
							@Nova_Detail
							</a>

						</div>

					</div>

					<!-- Карта, правый блок -->
					<div class="contacts__map">
	
						<iframe
						  src={mapSrc}
						  title="Нова Детейлинг на Яндекс Картах: Новороссийск, наб. Адмирала Серебрякова, 79Г"
						  class="contacts__map-frame"
						  loading="lazy"
						  allowfullscreen
						  referrerpolicy="strict-origin-when-cross-origin"
						></iframe>
					
					</div>

				</div>


			
			</div>
		
		</section>

		<style>

			.contacts {
				margin-bottom: 12rem;
				scroll-margin-top: 10rem;
			}

			.container {
				max-width: 124rem;
				width: 100%;
				padding: 0 2rem;
				margin: 0 auto;
			}

			.contacts__header {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
				margin-bottom: 6rem;
			}

			.contacts__text {
				max-width: 74.5rem;
				text-align: center;
			}

			.contacts__content {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				column-gap: 2rem;
			}

			.contacts__info {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 4rem;
			}

			.contacts__item {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 1rem;
			}

			.contacts__label {
				font-family: 'Roboto', sans-serif;
				font-weight: 400;
				font-size: 2rem;
				line-height: 1.15;
				letter-spacing: -0.05rem;
			}

			.contacts__value {
				font-family: 'Roboto', sans-serif;
				font-weight: 500;
				font-size: 2.4rem;
				line-height: 1.21;
				letter-spacing: -0.05rem;
				color: #000;
				text-decoration: none;
			}


			.contacts__value--accent:hover {
				color: #F94103;
			}

			.contacts__map {
				width: 100%;
				min-height: 44rem;
				border-radius: 3rem;
				overflow: hidden;
			}

			.contacts__map-frame {
				display: block;
				width: 100%;
				height: 100%;
				border: 0;
			}


			@media (max-width: 768px) {

				.contacts {
					margin-bottom: 8rem;
				}

				.container {
					max-width: 100%;
					width: 100%;
					padding: 0 2rem; 
				}

				.contacts__header {
					align-items: flex-start;
					margin-bottom: 6rem;
					gap: 1.4rem;
				}

				.contacts__title {
					font-size: 3.8rem;
					text-align: left;
				}

				.contacts__text {
					text-align: left;
				}

				.contacts__content {
    				grid-template-columns: 1fr;
					row-gap: 4rem;
				}

				.contacts__map {
					min-height: 0;
					height: 24rem;
					border-radius: 2.4rem;
				}

				.contacts__value--accent.contacts__value--phone { 
					color: #F94103;
				}

				.contacts__value--accent.contacts__value--telegram {
					color: #F94103;
				}

			}

		</style>