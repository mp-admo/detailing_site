---

 <!-- Контакты и форма -->
		<section id="contacts" class="contacts">

			<div class="container">

				<div class="contacts__header">

				<h2 class="contacts__title">
					Бесплатная консультация
				</h2>

				<p class="contacts__text">
					Подберём оптимальное решение под ваш автомобиль, подробно расскажем о работах и сориентируем по стоимости. Оставьте заявку — свяжемся с вами в ближайшее время и ответим на все вопросы.
				</p>

				</div>

				<div class="contacts__content">

					<!-- Контактная информация, левый блок -->
					 <div class="contacts__info">
						
						<!-- Телефон -->
						<div class="contacts__item">

							<span class="contacts__label">
								Телефон:
							</span>

							<a href="tel:+79184641250" class="contacts__value contacts__value--accent">
								+7 (918) 464-12-50
							</a>

						</div>

						<!-- Режим работы -->
						<div class="contacts__item">

							<span class="contacts__label">
								Режим работы:
							</span>

							<p class="contacts__value">
								Ежедневно с 9:00 до 18:00
							</p>

						</div>

						<!-- Адрес -->
						<div class="contacts__item">

							<span class="contacts__label">
								Адрес:
							</span>

							<p class="contacts__value">
								Новороссийск, <br />
								Наб. Адмирала Серебрякова, 79Г
							</p>

						</div>

						<!-- Соц. сети -->
						<div class="contacts__socials">

							<!-- Телеграм -->
							<div class="contacts__item">
								
								<span class="contacts__label">
								Telegram:
							    </span>
								
								<a href="#" class="contacts__value contacts__value--accent">
								@Nova_Detail_NVR
							    </a>

							</div>

							<!-- Почта -->
							<div class="contacts__item">
								
								<span class="contacts__label">
								Email:
							    </span>
								
								<a href="#" class="contacts__value contacts__value--accent">
								novadetail@yandex.ru
							    </a>

							</div>

						</div>

					</div>

					<!-- Форма, правый блок -->
					<form class="contacts__form">

						<div class="contacts__form-row">
							
							<!-- Имя -->
							<div class="contacts__form-item">

								<label for="name" class="contacts__form-label">
									Имя
								</label>

								<input type="text" id="name" name="name" placeholder="ваше имя" class="contacts__input" />

							</div>

							<!-- Телефон -->
							 <div class="contacts__form-item">

								<label for="phone" class="contacts__form-label">
									Телефон
								</label>

								<input type="tel" id="phone" name="phone" placeholder="+7 (999) 999-99-99" class="contacts__input" />

							 </div>

						</div>

						<!-- Сообщение -->
						 <div class="contacts__form-item">

							<label for="message" class="contacts__form-label">
								Сообщение
							</label>

							<textarea 
								id="message"
								name="message"
								placeholder="опишите задачу или услугу"
								class="contacts__textarea"></textarea>

						 </div>

						<!-- Кнопка -->
						 <button type="submit" class="contacts__button">
							Отправить заявку
						 </button>
						 
					</form>

				</div>

				<!-- Карта -->
				<div class="contacts__map">

					<img
					  src="/map.jpg"
					  alt="Карта с расположением детейлинг студии Nova"
					  class="contacts__map-image"
					/>
				
				</div>
			
			</div>
		
		</section>

		<style>

			.contacts {
				margin-bottom: 12rem;
				scroll-margin-top: 10rem;
			}

			.container {
				max-width: 124rem;
				width: 100%;
				padding: 0 2rem;
				margin: 0 auto;
			}

			.contacts__header {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
				margin-bottom: 6rem;
			}

			.contacts__text {
				max-width: 74.5rem;
				text-align: center;
			}

			.contacts__content {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				column-gap: 2rem;
				margin-bottom: 8rem;
			}

			.contacts__info {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 4rem;
			}

			.contacts__item {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 1rem;
			}

			.contacts__label {
				font-family: 'Roboto', sans-serif;
				font-weight: 400;
				font-size: 2rem;
				line-height: 1.15;
				letter-spacing: -0.05rem;
			}

			.contacts__value {
				font-family: 'Roboto', sans-serif;
				font-weight: 500;
				font-size: 2.4rem;
				line-height: 1.21;
				letter-spacing: -0.05rem;
				color: #000;
				text-decoration: none;
			}


			.contacts__value--accent:hover {
				color: #F94103;
			}

			.contacts__socials {
				display: flex;
				align-items: flex-start;
				gap: 6rem;
			}

			.contacts__form-row {
				display: flex;
				align-items: flex-start;
				gap: 2rem;
				margin-bottom: 3rem;
			}

			.contacts__form-item {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 1.2rem;
			}

			.contacts__form-row .contacts__form-item{
				flex: 1;
			}

			.contacts__input{
				background-color: #E0E0E0;
				border-radius: 3rem;
				border: none;
				padding: 1.6rem 2.4rem;
				width: 100%;
				font-size: 1.6rem;
				line-height: 1.5;
			}

			.contacts__textarea{
				height: 15.8rem;
				background-color: #E0E0E0;
				border-radius: 3rem;
				border: none;
				padding: 1.6rem 2.4rem;
				width: 100%;
				font-size: 1.6rem;
				line-height: 1.5;
				margin-bottom: 3.1rem;
				resize: none;
			}

			.contacts__input:focus {
				outline: 2px solid #F94103;
			}

			.contacts__textarea:focus {
				outline: 2px solid #F94103;
			}

			.contacts__form-label{
				font-size: 1.6rem;
				font-weight: 500;
				line-height: 1.5;
				color: #000;
			}

			.contacts__button{
				background-color: #fff;
				border: 1px solid #F94103;
				color: #F94103;
				border-radius: 2.5rem;
				padding: 1.4rem 7.9rem ;
				cursor: pointer;
				transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
			}

			.contacts__button:hover{
				background-color: #F94103;
				color: #fff;
			}

			.contacts__button:active {
				transform: scale(0.98);
			}

			.contacts__map {
				width: 100%;
				height: 44rem;
			}

			.contacts__map-image{
				width: 100%;
    			height: 100%;
				border-radius: 3rem;
    			object-fit: cover;
			}





			














		</style>