	---

	---

		<!-- Футер -->
		<footer class="footer"> 

				
			<!-- Верхняя часть -->
			<div class="footer__top">

				<div class="container"> 

					<img
						src="/logo_02_nova.svg"
						alt="Логотип Nova Detail"
						class="footer__logo"
					/>

					<div class="footer__grid">

						<!-- Футер информация -->
						<div class="footer__info">

							<h5 class="footer__title">
								Информация
							</h5>

							<p class="footer__text">
								Детейлинг услуги в Новороссийске. Удаление вмятин, полировка кузова, ремонт фар, оклейка полиуретаном, химчистка салона и другие услуги по уходу за автомобилем. Работаем с любыми автомобилями и доводим результат до идеала.
							</p>

							<a href="#contacts" class="footer__button">
								Записаться на осмотр
							</a>

						</div>

						<!-- Футер контакты -->
						<div class="footer__contacts">

							<h5 class="footer__title">
								Контакты
							</h5>

							<div class="footer__contacts--list">

								<a href="tel:+79184641250" class="footer__value footer__value--accent">
									+7 (918) 464-12-50
								</a>

								<a href="#" class="footer__value footer__value--accent">
									@Nova_Detail_NVR
								</a>

								<a href="#" class="footer__value footer__value--accent">
									novadetail@yandex.ru
								</a>

								<p class="footer__value">
									Ежедневно с 9:00 до 18:00
								</p>

								<p class="footer__value">
									Новороссийск, <br/>
									 Наб. Адмирала Серебрякова, 79Г
								</p>

							</div>
						
						</div>

						<!-- Футер сервисы -->
						<div class="footer__services">

							<h5 class="footer__title">
								Услуги
							</h5>
							
							<ul class="footer__services-list">

								<li class="footer__services-item">

									<a href="#services" class="footer__value footer__value--accent">
									Удаление вмятин
									</a>

								</li>

								<li class="footer__services-item">
								
									<a href="#services" class="footer__value footer__value--accent">
										Ремонт фар
									</a>

								</li>

								<li class="footer__services-item">
								
									<a href="#services" class="footer__value footer__value--accent">
										Полировка кузова
									</a>

								</li>

								<li class="footer__services-item">

									<a href="#services" class="footer__value footer__value--accent">
										Химчистка
									</a>

								</li>

								<li class="footer__services-item">

									<a href="#services" class="footer__value footer__value--accent">
										Оклейка полиуретаном
									</a>

								</li>

								<li class="footer__services-item">

									<a href="#services" class="footer__value footer__value--accent">
										Шумоизоляция
									</a>

								</li>

								<li class="footer__services-item">

									<a href="#services" class="footer__value footer__value--accent">
										Тонировка
									</a>

								</li>

							</ul>
						
						</div>

					</div>
				
				</div>

			</div>


			<!-- Нижняя часть -->
			<div class="footer__bottom">

				<div class="container">

					<p class="footer__copyright">
						© NOVA DETAIL, 2026. Все права защищены.
					</p>

					<div class="footer__developer">

						<img
							src="/dojo_star_icon.svg"
							alt=""
							class="footer__developer-icon"
						/>

						<p class="footer__developer-text">
							Дизайн и разработка - dojotal
						</p>

					</div>

				</div>

			</div>

		</footer>

		<style>

			.footer {
				background-color: #1c1c1c;
			}

			.container {
				max-width: 124rem;
				width: 100%;
				padding: 0 2rem;
				margin: 0 auto;
			}

			.footer__logo {
				width: 28.4rem;
				height: 100%;
				margin-bottom: 6rem;
			}

			.footer__top {
				padding: 8rem 0 8rem;
			}

			.footer__grid {
				display: grid;
				grid-template-columns: repeat(12, 1fr);
				column-gap: 2rem;
			}

			.footer__info {
				grid-column: span 5;
			}

			.footer__contacts {
				grid-column: span 4;
			}

			.footer__services {
				grid-column: span 3;
			}

			.footer__info {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				
			}

			.footer__title {
				color: #fff;
				margin-bottom: 2rem;
			}

			.footer__text {
				font-size: 1.6rem;
				font-weight: 400;
				line-height: 1.18;
				max-width: 38.7rem;
				color: #fff;
				margin-bottom: 6.5rem;
			}

			.footer__button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 1.4rem 4rem;
				background-color: #fff;
				color: #F94103;
				border-radius: 2.5rem;
				text-decoration: none;
				font-family: 'Inter', sans-serif;
				font-weight: 500;
				font-size: 1.4rem;
				line-height: 1.28;
				letter-spacing: -0.03rem;
				transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
				}

			.footer__button:hover {
				background-color: #F94103;
				color: #fff;
			}

			.footer__button:active {
				transform: scale(0.98);
			}
			
			.footer__contacts--list {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 1.4rem;
			}

			.footer__value {
				font-size: 1.6rem;
				font-weight: 400;
				line-height: 1.18;
				color: #fff;
				text-decoration: none;
			}

			.footer__value--accent:hover {
				color: #F94103;
			}

			.footer__services-list {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 1.4rem;
			}

			.footer__bottom {
				background-color: #e0e0e0;
				padding: 1.6rem 0;
			}

			.footer__bottom .container {
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.footer__developer {
				display: flex;
				align-items: center;
				gap: 0.7rem;
			}

			.footer__copyright {
				font-family: 'Roboto', sans-serif;
				font-size: 1.6rem;
				font-weight: 400;
				line-height: 1.8;
				letter-spacing: -0.05rem;
				color: #000;
			}

			.footer__developer-icon {
				height: 2.1rem;
			}

			.footer__developer-text {
				font-family: 'Roboto', sans-serif;
				font-size: 1.6rem;
				font-weight: 400;
				line-height: 1.8;
				letter-spacing: -0.05rem;
				color: #000;
			}

		</style>