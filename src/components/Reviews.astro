<!-- Отзывы -->
		<section id="reviews" class="reviews">

			<div class="container">

				<div class="reviews__header">

					<h2 class="reviews__title">
					Отзывы клиентов
					</h2>

					<p class="reviews__text">
						Реальные впечатления клиентов о нашей работе и результате.
					</p>

				</div>
				
				<!-- Карточки отзывов -->
				 <ul class="reviews__grid">
					
					<!-- Отзыв 1 -->
					<li class="reviews__card">
						
						<div class="reviews__card-header">
							
							<img src="/profile_review_icon.svg" alt="Иконка профиля клиента" class="reviews__icon" />
							
							<div class="reviews__card-info">
								
								<div class="reviews__card-meta">
									
									<span class="reviews__card-name">
										Алексей
									</span>

									<span class="reviews__card-dot">
										•
								    </span>
									
									<span class="reviews__card-date">
										12.03.2026
									</span>
								
								</div>
								
								<span class="reviews__card-stars">
									★★★★★
								</span>
							
							</div>
						
						</div>
						
						<p class="reviews__card-text">
							Обратился по удалению вмятины на двери. Сделали аккуратно, без покраски, вообще не видно, что что-то было. Видно, что ребята знают своё дело.
						</p>
					
					</li>

					<!-- Отзыв 2 -->
					<li class="reviews__card">
						
						<div class="reviews__card-header">
							
							<img src="/profile_review_icon.svg" alt="Иконка профиля клиента" class="reviews__icon" />
							
							<div class="reviews__card-info">
								
								<div class="reviews__card-meta">
									
									<span class="reviews__card-name">
										Ирина
									</span>

									<span class="reviews__card-dot">
										•
								    </span>
									
									<span class="reviews__card-date">
										05.03.2026
									</span>
								
								</div>
								
								<span class="reviews__card-stars">
									★★★★★
								</span>
							
							</div>
						
						</div>
						
						<p class="reviews__card-text">
							Делала полировку и химчистку салона. Машина стала как новая, и снаружи, и внутри. Всё сделали аккуратно, без спешки. Очень приятное отношение, теперь только к вам.
						</p>
					
					</li>

					<!-- Отзыв 3 -->
					<li class="reviews__card">
						
						<div class="reviews__card-header">
							
							<img src="/profile_review_icon.svg" alt="Иконка профиля клиента" class="reviews__icon" />
							
							<div class="reviews__card-info">
								
								<div class="reviews__card-meta">
									
									<span class="reviews__card-name">
										Дмитрий
									</span>

									<span class="reviews__card-dot">
										•
								    </span>
									
									<span class="reviews__card-date">
										27.02.2026
									</span>
								
								</div>
								
								<span class="reviews__card-stars">
									★★★★★
								</span>
							
							</div>
						
						</div>
						
						<p class="reviews__card-text">
							Обращался за оклейкой и тонировкой. Сделали качественно, без косяков, всё ровно и аккуратно. Объяснили все нюансы, подсказали, как лучше сделать. Рекомендую!
						</p>
					
					</li>

				 </ul>
				
			</div>
		
		</section>

		<style>
			
			.reviews {
				margin-bottom: 12rem;
				scroll-margin-top: 10rem;

			}

			.container {
				max-width: 124rem;
				width: 100%;
				padding: 0 2rem;
				margin: 0 auto;
			}

			.reviews__header {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
				margin-bottom: 6rem;
				text-align: center;
			}

			.reviews__grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				column-gap: 2rem;
				row-gap: 2rem;
			}

			.reviews__card {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				padding: 3rem;
				gap: 3rem;
				background-color: #E0E0E0;
				border-radius: 3rem;
			}

			.reviews__card-header {
				display: flex;
				align-items: center;
				gap: 2rem;
				cursor: default;
			}

			.reviews__icon {
				width: 5.2rem;
				height: 5.2rem;
			}

			.reviews__card-info {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 0.5rem;
				
			}

			.reviews__card-meta {
				display: flex;
				align-items: center;
				gap: 1rem;
				font-family: 'Roboto', sans-serif;
				font-weight: 400;
				font-size: 1.8rem;
				line-height: 1.16;
				letter-spacing: -0.05rem;
				color: #000;
			}

			.reviews__card-text {
				line-height: 1.21;
			}

			.reviews__card-stars {
				font-size: 2rem;
				line-height: 1;
				color: #FBB41A;
			}

		</style>