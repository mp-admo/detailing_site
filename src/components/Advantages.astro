---

<!-- Особенности -->
		 <section id="features" class="features">
			
			<div class="features__container">

				<ul class="features__list">

					<!-- Особенность 1 -->
					 <li class="features__item">
						<img src="/person_icon.svg" alt="" class="features__icon" />

						<div class="features__info">

							<h5 class="features__title">
								Без покраски и без риска
							</h5>

							<p class="features__text">
								Сохраняем родное лакокрасочное покрытие автомобиля
							</p>

						</div>
					 </li>

					<!-- Особенность 2 -->
					 <li class="features__item">
						<img src="/shine_icon.svg" alt="" class="features__icon" />

						<div class="features__info">

							<h5 class="features__title">
								Опытные мастера
							</h5>

							<p class="features__text">
								Много лет опыта и постоянное повышение квалификации
							</p>

						</div>
					 </li>

					 <!-- Особенность 3 -->
					 <li class="features__item">
						<img src="/target_icon.svg" alt="" class="features__icon" />

						<div class="features__info">

							<h5 class="features__title">
								Работаем на результат
							</h5>

							<p class="features__text">
								Делаем до идеала — без спешки и компромиссов по качеству
							</p>

						</div>
					 </li>

				</ul>

			</div>
		
		</section>

		<!-- Преимущества -->
		 <section id="advantages" class="advantages">

			<div class="advantages__container">

				<h2 class="advantages__title">
					<span>Почему нам</span>
					<span>доверяют</span>
				</h2>

				<!-- 5 карточек преимуществ -->
				 <ul class="advantages__grid">
					
					<!-- Карточка 01 -->
					 <li class="advantages__card">

						<div class="advantages__card-header">
							
							<img src="/star_advantages.svg" alt="" class="advantages__icon" />

							<span class="advantages__number">
								01
							</span>
						
						</div>

						<h4 class="advantages__card-title">
							Сохраняем родное покрытие
						</h4>

						<p class="advantages__card-text">
							Аккуратно устраняем дефекты и работаем по технологии, сохраняя заводское лакокрасочное покрытие.
						</p>

					</li>
					
					<!-- Карточка 02 -->
					 <li class="advantages__card">

						<div class="advantages__card-header">
							
							<img src="/star_advantages.svg" alt="" class="advantages__icon" />

							<span class="advantages__number">
								02
							</span>
						
						</div>

						<h4 class="advantages__card-title">
							Опытные мастера
						</h4>

						<p class="advantages__card-text">
							Много лет в детейлинге, постоянное обучение и практика — знаем, как работать с любыми автомобилями.
						</p>

					</li>

					<!-- Карточка 03 -->
					 <li class="advantages__card">

						<div class="advantages__card-header">
							
							<img src="/star_advantages.svg" alt="" class="advantages__icon" />

							<span class="advantages__number">
								03
							</span>
						
						</div>

						<h4 class="advantages__card-title">
							Делаем до результата
						</h4>

						<p class="advantages__card-text">
							Не сдаём работу «как получилось». Доводим каждый автомобиль до состояния, за которое не стыдно.
						</p>

					</li>

					<!-- Карточка 04 -->
					 <li class="advantages__card">

						<div class="advantages__card-header">
							
							<img src="/star_advantages.svg" alt="" class="advantages__icon" />

							<span class="advantages__number">
								04
							</span>
						
						</div>

						<h4 class="advantages__card-title">
							Честная оценка работы
						</h4>

						<p class="advantages__card-text">
							Подбираем оптимальное решение под конкретную ситуацию без навязывания лишних услуг и работ.
						</p>

					</li>

					<!-- Карточка 05 -->
					 <li class="advantages__card">

						<div class="advantages__card-header">
							
							<img src="/star_advantages.svg" alt="" class="advantages__icon" />

							<span class="advantages__number">
								05
							</span>
						
						</div>

						<h4 class="advantages__card-title">
							Бережное отношение к авто
						</h4>

						<p class="advantages__card-text">
							Внимание к деталям, аккуратность в работе и реальное отношение, а не поток.
						</p>

					</li>

				</ul>
			
			</div>

		 </section>

		 <style>

			.features {
				margin: 10rem 0 12rem 0;
				scroll-margin-top: 10rem;
			}

			.features__container {
				max-width: 124rem;
				width: 100%;
				padding: 0 2rem;
				margin: 0 auto;
			}

			.features__list {
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.features__item {
				display: flex;
				align-items: center;
			}

			.features__icon {
				width: 6.2rem;
				height: 6.2rem;
			}

			.features__info {
				display: flex;
				flex-direction: column;
				justify-content: center;
				height: 8rem;
				gap: 0.9rem;
				border-left: 0.2rem solid #E0E0E0;
				padding-left: 2rem;
				margin-left: 2rem;
			}

			.features__text {
				max-width: 28.5rem;
				line-height: 1.21;
			}


			.advantages {
				margin-bottom: 9rem;
			}
		
			.advantages__container {
				max-width: 124rem;
				width: 100%;
				padding: 0 2rem;
				margin: 0 auto;
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				column-gap: 2rem;
				row-gap: 2rem;
			}

			.advantages__grid {
				display: contents;
			}

			.advantages__title span {
				display: block;
			}

			.advantages__title span:first-child {
				color: #000;
			}

			.advantages__title span:last-child {
				color: #828282;
			}

			.advantages__card {
				background-color: #E0E0E0;
				border-radius: 3rem;
				padding: 3rem;
			}

			.advantages__card-header {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
			}

			.advantages__icon {
				width: 2rem;
			}

			.advantages__number {
				font-family: 'Montserrat', sans-serif;
				font-weight: 500;
				font-size: 6.4rem;
				line-height: 1;
				color: #fff;
				margin-top: -1rem;
				cursor: default;
			}

			.advantages__card-title {
				margin-bottom: 1rem;
				line-height: 1.2;
			}

			.advantages__card-text {
				font-size: 1.6rem;
				line-height: 1.18;
			}


			@media (max-width: 768px) {

				.features {
					margin: 4rem 0 8rem 0;
				}

				.features__container {
					max-width: 100%;
					width: 100%;
					padding: 0 2rem; 
				}
				
				.features__list {
					align-items: center;
					flex-direction: column;
					gap: 3rem;
				}

				.features__icon {
					width: 5rem;
					height: 5rem;
				}

				.features__info {
					display: flex;
					flex-direction: column;
					justify-content: center;
					height: rem;
					gap: 0.7rem;
					border-left: 0.2rem solid #E0E0E0;
					padding-left: 1.6rem;
					margin-left: 1.6rem;
				}

				.features__text {
					max-width: 24.2rem;
					line-height: 1.21;
				}

				.advantages__container {
					max-width: 100%;
					width: 100%;
					padding: 0 2rem; 
					grid-template-columns: 1fr;
					row-gap: 1.2rem;
				}

				.advantages__title {
					text-align: center;
					font-size: 3.8rem;
					margin-bottom: 3rem;
					
				}

				.advantages__card-text {
					font-size: 1.4rem;
					line height: 1.42;
				}

				.advantages__card {
				background-color: #E0E0E0;
				border-radius: 2.4rem;
				padding: 2.4rem;
			}
			
			}
			
		 </style>