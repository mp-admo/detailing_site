---

        <!--Секция Hero-->
		<section class="hero">

			<div class="container">
				
				<div class="hero__content">

					<h1 class="hero__title">
						<span>Детейлинг услуги</span>
						<span>в Новороссийске</span>
					</h1>
					
					<p class="hero__text">
						Удаление вмятин без покраски, полировка кузова, ремонт фар и оклейка авто. Работаем аккуратно, сохраняем заводское покрытие и доводим результат до идеала.
					</p>
					
					<div class="hero__actions">

						<a href="#contacts" class="hero__button">
							Записаться на осмотр
						</a>
						
						<p class="hero__note">
							<img src="/star.svg" alt="" class="hero__icon" />
							
							<span>
							Бесплатная консультация и оценка
						    </span>
						</p>
						
					</div>

				</div>

			</div>
		
		</section>

		<style>

			.hero {
				width: 100%;
				height: 70rem;
				position: relative;
				background-color: #E0E0E0;
				border-radius: 0 0 6rem 6rem;
				overflow: hidden;
				
			}

			.container {
				max-width: 124rem;
				height: 100%;
				margin: 0 auto;
				display: flex;
				align-items: flex-start;
				padding: 0 2rem;
				background-image: url('/hero_logo_nova.svg'), url('/hero_car.webp');
				background-repeat: no-repeat, no-repeat;
				background-size: 120rem, 94.5rem;
				background-position: center bottom -5.8rem, center bottom 2rem;
			}

			.hero__content {
				max-width: 48.3rem;
				width: 100%;
				display: flex;
				flex-direction: column;
				margin-top: 8.5rem;
				z-index: 10;
			}

			.hero__title {
				margin-bottom: 1.8rem;
			}

			.hero__title span {
    			display: block;
			}

			
			.hero__title span:first-child {
				color: #000;
			}

			.hero__title span:last-child {
				color: #828282;
			}

			.hero__text {
				margin-bottom: 6rem;
			}

			.hero__button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 1.4rem 2.1rem;
				background-color: #fff;
				border: 1px solid #F94103;
				border-radius: 2.5rem;
				text-decoration: none;
				font-family: 'Inter', sans-serif;
				font-weight: 500;
				font-size: 1.4rem;
				line-height: 1.28;
				letter-spacing: -0.03rem;
				color: #F94103;
				transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
				margin-bottom: 2rem;
			}

			.hero__button:hover {
				background-color: #F94103;
				color: #fff;
			}

			.hero__button:active {
				transform: scale(0.98);
			}

			.hero__note {
				display: flex;
				align-items: center;
				gap: 0.8rem;
			}

			.hero__icon {
				width: 1.5rem;
			}

			.hero__note span {
				font-weight: 400;
				font-size: 1.2rem;
				line-height: 1.33;
				color: #000;
			}
			
		</style>