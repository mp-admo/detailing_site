	---

	---

	<header class="header">
			
			<nav class="header__nav">

				<!-- Левая часть хедера -->
				<div class="header__left">

					<!--Логотип-->
					<a href="#" class="header__logo">
						<img
						src="/logo_01_nova.svg"
						alt="Логотип Nova Detail"
						class="header__logo-image"
						/>
					</a>

					<!--Навигация-->
					<ul class="header__list">
						<li>
							<a href="#features">Преимущества</a>
						</li>

						<li>
							<a href="#services">Услуги</a>
						</li>

						<li>
							<a href="#contacts">Контакты</a>
						</li>

						<li>
							<a href="#reviews">Отзывы</a>
						</li>

						<li>
							<a href="#gallery">Наши Работы</a>
						</li>

					</ul>

				</div>

				<!-- Правая часть хедера -->
				<div class="header__right">
			
					<!-- Адрес -->
					<div class="header__address">
						<img src="/pin.svg" alt="" class="header__address-icon"/>

						<span class="header__address-text">
							г.Новороссийск
						</span>
					</div>

					<!-- Телефон -->
					<a href="tel:+79184641250" class="phone__button">
						+7 (918) 464-12-50
					</a>

				</div>

				<button class="burger-button">
					<span></span>
					<span></span>
					<span></span>
				</button>
		
			</nav>

		</header>


		<!-- Шторка -->
		<div class="mobile-menu">

			<ul class="mobile-menu__list">

				<li>
					<a href="#features">Преимущества</a>
				</li>

				<li>
					<a href="#services">Услуги</a>
				</li>

				<li>
					<a href="#contacts">Контакты</a>
				</li>

				<li>
					<a href="#reviews">Отзывы</a>
				</li>

				<li>
					<a href="#gallery">Наши Работы</a>
				</li>

			</ul>

			<div class="mobile-menu__info">

				<a href="https://t.me/Nova_Detail" class="mobile-menu__value mobile-menu__value--accent"
				target="_blank" rel="noopener noreferrer">
					@Nova_Detail
				</a>

				<p class="mobile-menu__value">
					Ежедневно с 9:00 до 18:00
				</p>

				<p class="mobile-menu__value">
					Новороссийск, <br/>
						Наб. Адмирала Серебрякова, 79Г
				</p>

			</div>

			<a href="tel:+79184641250" class="mobile-menu__phone">
					+7 (918) 464-12-50
			</a>

		</div>


		<!-- Стиль -->
		<style>

			.header {
				background-color: #E0E0E0;
				height: 7.6rem;
				display: flex;
				align-items: center;
				position: sticky;
				top: 0;
				z-index: 100;
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
			}

			.header__nav {
				display: flex;
				justify-content: space-between;
				align-items: center;
				width: 100%;
				max-width: 124rem;
				padding: 0 2rem;
				margin: 0 auto;
				height: 100%;
			}

			.header__list {
				display: flex;
				gap: 3rem;
				list-style: none;
			}

			.header__list a {
				text-decoration: none;
				font-family: 'Roboto', sans-serif;
				font-weight: 400;
				font-size: 1.4rem;
				line-height: 1.43;
				color: #000;
				margin: 0;
			}

			.header__list a:hover {
				color: #F94103;
			}

			.header__address {
				display: flex;
				align-items: center;
				gap: 0.7rem;
			}

			.header__address-icon {
				width: 1.1rem;
				height: 1.4rem;
			}

			.header__address-text {
				text-decoration: none;
				font-family: 'Roboto', sans-serif;
				font-weight: 500;
				font-size: 1.4rem;
				line-height: 1.43;
				color: #F94103;
			}
			
			.header__logo-image {
				width: 5.5rem;
				height: 3.8rem;
			}

			.header__left {
				display: flex;
				gap: 6rem;
				align-items: center;
			}

			.header__right {
				display: flex;
				gap: 3rem;
				align-items: center;
			}

			.phone__button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 1.4rem 2.1rem;
				background-color: #fff;
				border: 1px solid #F94103;
				border-radius: 2.5rem;
				text-decoration: none;
				font-family: 'inter', sans-serif;
				font-weight: 500;
				font-size: 1.4rem;
				line-height: 1.28;
				letter-spacing: -0.03rem;
				color: #F94103;
				transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
			}

			.phone__button:hover {
				background-color: #F94103;
				color: #fff;
			}

			.phone__button:active {
				transform: scale(0.98);
			}

			.burger-button {
				display: none;
			}

			/* Стилизация шторки */
			.mobile-menu {
				position: fixed;
				top: 5.6rem;
				left: 0;
				width: 100%;
				height: calc(100vh - 5.6rem);
				background-color: #E0E0E0;
				z-index: 200;
				padding: 6rem 2rem 6rem 2rem;
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				opacity: 0;
				visibility: hidden;
				transition: opacity 0.3s ease, visibility 0.3s ease;
			}

			.mobile-menu__list {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 1.8rem;
				margin-bottom: 6rem;
			}

			.mobile-menu__list a {
				text-decoration: none;
				font-family: 'Roboto', sans-serif;
				font-weight: 400;
				font-size: 1.8rem;
				line-height: 1.16;
				letter-spacing: -0.05rem;
				color: #000;
			}

			.mobile-menu__info {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 1.6rem;
				margin-bottom: 6rem;
			}

			.mobile-menu__value {
				text-decoration: none;
				font-weight: 500;
				font-size: 1.6rem;
				line-height: 1.18;
				color: #000;
			}

			.mobile-menu__value--accent {
				color: #F94103;
				font-size: 1.8rem;
			}

			.mobile-menu__phone {
				display: inline-flex;
				align-items: center;
				align-self: flex-start;
				justify-content: center;
				padding: 1.4rem 4.6rem;
				background-color: #F94103;
				border-radius: 2.5rem;
				text-decoration: none;
				font-family: 'inter', sans-serif;
				font-weight: 500;
				font-size: 1.4rem;
				line-height: 1.28;
				letter-spacing: -0.03rem;
				color: #fff;
				transition: transform 0.2s ease;
			}

			.mobile-menu__phone:active {
				transform: scale(0.98);
			}

			.mobile-menu.is-open {
				opacity: 1;
				visibility: visible;
			}


			@media (max-width: 768px) {

				.burger-button {
					display: flex;
				}

				.header__list,
				.header__right {
					display: none;
				}

				.header {
					height: 5.6rem;
				}

				.header__nav {
					padding: 0 2rem;
				}

				.burger-button {
					display: flex;
					flex-direction: column;
					justify-content: center;
					gap: 0.4rem;
					background: transparent;
					border: none;
					cursor: pointer;
					padding: 0;
					position: absolute;
					top: 50%;
					right: 2rem;
					transform: translateY(-50%); 
					z-index: 250; 
					height: 2rem;
					width: 2rem;
				}

				.burger-button span {
					display: block;
					width: 2rem;
					height: 0.26rem;
					background-color: #F94103;
					border-radius: 1rem;
					transition: transform 0.3s ease, opacity 0.3s ease;
				}

				.burger-button--active span:nth-child(1) {
					transform: translateY(0.66rem) rotate(45deg);
				}

				.burger-button--active span:nth-child(2) {
					opacity: 0;
				}

				.burger-button--active span:nth-child(3) {
					transform: translateY(-0.66rem) rotate(-45deg);
				}

				.header__left {
					gap: 0;
				}
			}


		</style>

		<script>
			const burgerBtn = document.querySelector('.burger-button');
			const mobileMenu = document.querySelector('.mobile-menu');
			const menuLinks = document.querySelectorAll('.mobile-menu__list a');

			if (burgerBtn && mobileMenu) {
				burgerBtn.addEventListener('click', () => {
					mobileMenu.classList.toggle('is-open');
					burgerBtn.classList.toggle('burger-button--active');
					
					if (mobileMenu.classList.contains('is-open')) {
						document.body.style.overflow = 'hidden';
					} else {
						document.body.style.overflow = '';
					}
				});
			}

			if (menuLinks && mobileMenu && burgerBtn) {
				menuLinks.forEach(link => {
					link.addEventListener('click', () => {
						mobileMenu.classList.remove('is-open');
						burgerBtn.classList.remove('burger-button--active');
						document.body.style.overflow = '';
					});
				});
			}
		</script>