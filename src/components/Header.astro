				<!--Логотип-->
				<a href="#" class="header__logo">
					<img
					src="/logo_01_nova.svg"
					alt="Логотип Nova Detail"
					class="header__logo-image"
					/>
				</a>

            	<!--Навигация-->
				<ul class="header__list">
					<li>
						<a href="#features">Преимущества</a>
					</li>

					<li>
						<a href="#services">Услуги</a>
					</li>

					<li>
						<a href="#contacts">Контакты</a>
					</li>

					<li>
						<a href="#reviews">Отзывы</a>
					</li>

					<li>
						<a href="#gallery">Наши Работы</a>
					</li>

				</ul>

			</div>

			<!-- Правая часть хедера -->
			<div class="header__right">
		
            	<!-- Адрес -->
				<div class="header__address">
					<img src="/pin.svg" alt="" class="header__address-icon"/>

					<span class="header__address-text">
						г.Новороссийск
					</span>
				</div>

		    	<!-- Телефон -->
				<a href="tel:+79184641250" class="phone__button">
					+7 (918) 464-12-50
				</a>

			</div>

			<button class="burger-button">
				<span></span>
				<span></span>
				<span></span>
			</button>
	
		</nav>

	</header>

	<div class="mobile-menu">

		<div class="momobile-menu__overlay"> </div>

		<div class="mobile-menu__panel">

			<button class="mobile-menu__close">
				&times;
			</button>

			<ul class="mobile-menu__list">

				<li>
					<a href="#features">Преимущества</a>
				</li>

				<li>
					<a href="#services">Услуги</a>
				</li>

				<li>
					<a href="#contacts">Контакты</a>
				</li>

				<li>
					<a href="#reviews">Отзывы</a>
				</li>

				<li>
					<a href="#gallery">Наши Работы</a>
				</li>

			</ul>

			<div class="mobile-menu__contacts">

				<a href="https://t.me/Nova_Detail" class="mobile-menu__social">
					@Nova_Detail
				</a>

				<p class="mobile-menu__value">
					Ежедневно с 9:00 до 18:00
				</p>

				<p class="mobile-menu__value">
					Новороссийск, <br/>
						Наб. Адмирала Серебрякова, 79Г
				</p>

				<a href="tel:+79184641250" class="mobile-menu__phone">
					+7 (918) 464-12-50
				</a>

			</div>

		</div>

	</div>

	<!-- Стиль -->
	<style>

		.header {
			background-color: #E0E0E0;
			height: 7.6rem;
			display: flex;
			align-items: center;
			position: sticky;
			top: 0;
			z-index: 100;
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
		}

		.header__nav {
			display: flex;
			justify-content: space-between;
			align-items: center;
			width: 100%;
			max-width: 124rem;
			padding: 0 2rem;
			margin: 0 auto;
			height: 100%;
		}

		.header__list {
			display: flex;
			gap: 3rem;
			list-style: none;
		}

		.header__list a {
			text-decoration: none;
			font-family: 'Roboto', sans-serif;
			font-weight: 400;
			font-size: 1.4rem;
			line-height: 1.43;
			color: #000;
			margin: 0;
		}

		.header__list a:hover {
			color: #F94103;
		}

		.header__address {
			display: flex;
			align-items: center;
			gap: 0.7rem;
		}

		.header__address-icon {
			width: 1.1rem;
			height: 1.4rem;
		}

		.header__address-text {
			text-decoration: none;
			font-family: 'Roboto', sans-serif;
			font-weight: 500;
			font-size: 1.4rem;
			line-height: 1.43;
			color: #F94103;
		}
		
		.header__logo-image {
			width: 5.5rem;
			height: 3.8rem;
		}

		.header__left {
			display: flex;
			gap: 6rem;
			align-items: center;
		}

		.header__right {
			display: flex;
			gap: 3rem;
			align-items: center;
		}

		.phone__button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 1.4rem 2.1rem;
			background-color: #fff;
			border: 1px solid #F94103;
			border-radius: 2.5rem;
			text-decoration: none;
			font-family: 'inter', sans-serif;
			font-weight: 500;
			font-size: 1.4rem;
			line-height: 1.28;
			letter-spacing: -0.03rem;
			color: #F94103;
			transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
		}

		.phone__button:hover {
			background-color: #F94103;
			color: #fff;
		}

		.phone__button:active {
			transform: scale(0.98);
		}

		.burger-button {
			display: none;
		}

		.mobile-menu {
			
		}



		@media (max-width: 768px) {

			.burger-button {
				display: flex;
			}

			.header__list,
			.header__right {
				display: none;
			}

			.header {
				height: 5.6rem;
			}

			.header__nav {
				padding: 0 2rem;
			}

			.burger-button {
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 0.4rem;
				background: transparent;
				border: none;
				cursor: pointer;
				padding: 0;
			}

			.burger-button span {
				display: block;
				width: 2rem;
				height: 0.26rem;
				background-color: #F94103;
				border-radius: 1rem;
			}

			.header__left {
				gap: 0;
			}
		}




	</style>