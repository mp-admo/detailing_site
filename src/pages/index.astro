
---
import Layout from "../layouts/Layout.astro";
---

<Layout>

	<header class="header">
		
		<nav class="header__nav">

			<!--Логотип-->
			<a href="#" class="header__logo">
				<img
				src="/logo_01_nova.svg" alt="Детейлинг студия Nova"
				width="55" height="38"
				/>
			</a>

            <!--Навигация-->
			<ul class="header__list">
				<li>
					<a href="#advantages">Преимущества</a>
				</li>

				<li>
					<a href="#services">Услуги</a>
				</li>

				<li>
					<a href="#contacts">Контакты</a>
				</li>
			</ul>
		
            <!-- Адрес -->
			<div class="header__address" role="contentinfo">
				<img src="/pin.svg" alt="" />

				<span>
					г.Новороссийск
				</span>
			</div>

		    <!-- Телефон -->
			<a href="tel:+79184641250" class="phone__button">
				+7 (918) 464-12-50
			</a>
	
		</nav>

	</header>


	<main>

		<!--Секция Hero-->
		<section class="hero">

			<div class="container">
				
				<div class="hero__content">

					<h1 class="hero__title">
						<span>Детейлинг услуги</span>
						<span>в Новороссийске</span>
					</h1>
					
					<p class="hero__text">
						Удаление вмятин без покраски, полировка кузова, ремонт фар и оклейка авто. Работаем аккуратно, сохраняем заводское покрытие и доводим результат до идеала.
					</p>
					
					<div class="hero__actions">

						<a href="#contacts" class="hero__button">
							Записаться на осмотр
						</a>
						
						<p class="hero__note">
							<img src="/star.svg" alt="" class="hero__icon" />
							
							<span>
							Бесплатная консультация и оценка
						    </span>
						</p>
						
					</div>

				</div>

			</div>
		
		</section>

		<!-- Особенности -->
		 <section class="features">
			
			<div class="container">

				<ul class="features__list">

					<!-- Особенность 1 -->
					 <li class="features_item">
						<img src="/person_icon.svg" alt="" class="features__icon" />

						<div class="features__info">

							<h5 class="features__title">
								Без покраски и без риска
							</h5>

							<p class="features__text">
								Сохраняем родное лакокрасочное покрытие автомобиля
							</p>

						</div>
					 </li>

					<!-- Особенность 2 -->
					 <li class="features_item">
						<img src="/shine_icon.svg" alt="" class="features__icon" />

						<div class="features__info">

							<h5 class="features__title">
								Опытные мастера
							</h5>

							<p class="features__text">
								Работаем с автомобилями много лет и постоянно повышаем квалификацию
							</p>

						</div>
					 </li>

					 <!-- Особенность 3 -->
					 <li class="features_item">
						<img src="/target_icon.svg" alt="" class="features__icon" />

						<div class="features__info">

							<h5 class="features__title">
								Работаем на результат
							</h5>

							<p class="features__text">
								Делаем до идеала — без спешки и компромиссов по качеству
							</p>

						</div>
					 </li>

				</ul>

			</div>
		
		</section>

		<!-- Преимущества -->
		 <section id="advantages" class="advantages">

			<div class="container">

				<h2 class="advantages__title">
					<span>Почему нам</span>
					<span>доверяют</span>
				</h2>

				<!-- 5 карточек преимуществ -->
				 <ul class="advantages__grid">
					
					<!-- Карточка 01 -->
					 <li class="advantages__card">

						<div class="advantages__card-header">
							
							<img src="/star_advantages.svg" alt="" class="advantages__icon" />

							<span class="advantages__number">
								01
							</span>
						
						</div>

						<h4 class="advantages__card-title">
							Сохраняем родное покрытие
						</h4>

						<p class="advantages__card-text">
							Аккуратно устраняем дефекты и работаем по технологии, сохраняя заводское лакокрасочное покрытие.
						</p>

					</li>
					
					<!-- Карточка 02 -->
					 <li class="advantages__card">

						<div class="advantages__card-header">
							
							<img src="/star_advantages.svg" alt="" class="advantages__icon" />

							<span class="advantages__number">
								02
							</span>
						
						</div>

						<h4 class="advantages__card-title">
							Опытные мастера
						</h4>

						<p class="advantages__card-text">
							Много лет в детейлинге, постоянное обучение и практика — знаем, как работать с любыми автомобилями.
						</p>

					</li>

					<!-- Карточка 03 -->
					 <li class="advantages__card">

						<div class="advantages__card-header">
							
							<img src="/star_advantages.svg" alt="" class="advantages__icon" />

							<span class="advantages__number">
								03
							</span>
						
						</div>

						<h4 class="advantages__card-title">
							Делаем до результата
						</h4>

						<p class="advantages__card-text">
							Не сдаём работу «как получилось». Доводим каждый автомобиль до состояния, за которое не стыдно.
						</p>

					</li>

					<!-- Карточка 04 -->
					 <li class="advantages__card">

						<div class="advantages__card-header">
							
							<img src="/star_advantages.svg" alt="" class="advantages__icon" />

							<span class="advantages__number">
								04
							</span>
						
						</div>

						<h4 class="advantages__card-title">
							Честная оценка работы
						</h4>

						<p class="advantages__card-text">
							Подбираем оптимальное решение под конкретную ситуацию без навязывания лишних услуг и работ.
						</p>

					</li>

					<!-- Карточка 05 -->
					 <li class="advantages__card">

						<div class="advantages__card-header">
							
							<img src="/star_advantages.svg" alt="" class="advantages__icon" />

							<span class="advantages__number">
								05
							</span>
						
						</div>

						<h4 class="advantages__card-title">
							Бережное отношение к авто
						</h4>

						<p class="advantages__card-text">
							Внимание к деталям, аккуратность в работе и реальное отношение, а не поток.
						</p>

					</li>

				</ul>
			
			</div>

		 </section>

		 <!-- Услуги -->
		 <section id="services" class="services">

			<div class="conteiner">

				<h2 class="services__title">
					Наши услуги детейлинга
				</h2>

				<p class="services_text">
					Удаление вмятин, полировка кузова, ремонт фар, оклейка и химчистка. Работаем с любыми автомобилями и доводим результат до идеала.
				</p>

				<!-- Карточки Сервисов -->
				 <ul class="services__grid">
					
					<!-- Карточка Удаление Вмятин -->
					 <li class="services__card">

						<a href="#contacts" class="services__button">
							Записаться
						</a>

						<div class="services__card-content">

							<img src="/star_services.svg" alt"" class="services__icon">

							<h3 class="services__card-title">
								Удаление Вмятин
							</h3>

							<p class="services__card-text">
								Аккуратно устраняем вмятины без лишнего вмешательства в кузов. В большинстве случаев сохраняем заводское лакокрасочное покрытие и возвращаем детали первоначальный вид. Подбираем оптимальное решение под каждый случай.
							</p>

						</div>

					 </li>

					 <!-- Карточка Ремонт фар -->
					 <li class="services__card">

						<a href="#contacts" class="services__button">
							Записаться
						</a>

						<div class="services__card-content">

							<img src="/star_services.svg" alt"" class="services__icon">

							<h3 class="services__card-title">
								Ремонт фар
							</h3>

							<p class="services__card-text">
								Восстанавливаем прозрачность фар, устраняем помутнение, царапины и следы износа. Улучшаем внешний вид автомобиля и повышаем безопасность за счёт лучшей светопередачи. Используем проверенные материалы для стабильного результата.
							</p>

						</div>

					 </li>

					 <!-- Карточка Полировка Кузова -->
					 <li class="services__card">

						<a href="#contacts" class="services__button">
							Записаться
						</a>

						<div class="services__card-content">

							<img src="/star_services.svg" alt"" class="services__icon">

							<h3 class="services__card-title">
								Полировка Кузова
							</h3>

							<p class="services__card-text">
								Удаляем мелкие и средние дефекты, царапины и голограммы. Возвращаем кузову насыщенный цвет, глубину и блеск. Подбираем степень полировки индивидуально, чтобы сохранить покрытие и добиться аккуратного результата.
							</p>

						</div>

					 </li>

					 <!-- Карточка Химчистка -->
					 <li class="services__card">

						<a href="#contacts" class="services__button">
							Записаться
						</a>

						<div class="services__card-content">

							<img src="/star_services.svg" alt"" class="services__icon">

							<h3 class="services__card-title">
								Химчистка
							</h3>

							<p class="services__card-text">
								Проводим глубокую очистку салона от загрязнений, пыли и запахов. Работаем с тканью, кожей и пластиком, подбирая средства под материалы. Возвращаем салону свежий и ухоженный вид, уделяя внимание каждой детали.
							</p>

						</div>

					 </li>

					 <!-- Оклейка Полиуретаном -->
					 <li class="services__card">

						<a href="#contacts" class="services__button">
							Записаться
						</a>

						<div class="services__card-content">

							<img src="/star_services.svg" alt"" class="services__icon">

							<h3 class="services__card-title">
								Оклейка Полиуретаном
							</h3>

							<p class="services__card-text">
								Защищаем кузов от сколов, царапин и внешних воздействий полиуретановой плёнкой. Сохраняем внешний вид автомобиля и продлеваем срок службы покрытия. Работаем аккуратно, с вниманием к деталям и точной подгонкой материала.
							</p>

						</div>

					 </li>

						
					 <!-- Шумоизоляция -->
					 <li class="services__card">

						<a href="#contacts" class="services__button">
							Записаться
						</a>

						<div class="services__card-content">

							<img src="/star_services.svg" alt"" class="services__icon">

							<h3 class="services__card-title">
								Шумоизоляция
							</h3>

							<p class="services__card-text">
								Снижаем уровень шума от дороги, двигателя и внешней среды. Используем качественные материалы и соблюдаем технологию укладки. Обрабатываем ключевые зоны автомобиля, чтобы сделать его тише и комфортнее в повседневной эксплуатации.
							</p>

						</div>

					 </li>

					  <!-- Тонировка -->
					 <li class="services__card">

						<a href="#contacts" class="services__button">
							Записаться
						</a>

						<div class="services__card-content">

							<img src="/star_services.svg" alt"" class="services__icon">

							<h3 class="services__card-title">
								Тонировка
							</h3>

							<p class="services__card-text">
								Выполняем тонировку стекол с соблюдением норм и аккуратной установкой. Улучшаем внешний вид, повышаем комфорт и защищаем салон от солнца. Используем качественные плёнки и подбираем вариант под задачи автомобиля.
							</p>

						</div>

					 </li>
					
				</ul>

			</div>
		
		</section>






	</main>


</Layout>