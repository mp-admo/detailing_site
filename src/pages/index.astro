
---
import Layout from "../layouts/Layout.astro";
---

<Layout>

	<header class="header">
		
		<nav class="header__nav">

			<!--Логотип-->
			<a href="#" class="header__logo">
				<img
				src="/logo_01_nova.svg" alt="Детейлинг студия Nova"
				width="55" height="38"
				/>
			</a>

            <!--Навигация-->
			<ul class="header__list">
				<li>
					<a href="#advantages">Преимущества</a>
				</li>

				<li>
					<a href="#services">Услуги</a>
				</li>

				<li>
					<a href="#contacts">Контакты</a>
				</li>
			</ul>
		
            <!-- Адрес -->
			<div class="header__address" role="contentinfo">
				<img src="/pin.svg" alt="" />

				<span>
					г.Новороссийск
				</span>
			</div>

		    <!-- Телефон -->
			<a href="tel:+79184641250" class="phone__button">
				+7 (918) 464-12-50
			</a>
	
		</nav>

	</header>


	<main>

		<!--Секция Hero-->
		<section class="hero">

			<div class="container">
				
				<div class="hero__content">

					<h1 class="hero__title">
						<span>Детейлинг услуги</span>
						<span>в Новороссийске</span>
					</h1>
					
					<p class="hero__text">
						Удаление вмятин без покраски, полировка кузова, ремонт фар и оклейка авто. Работаем аккуратно, сохраняем заводское покрытие и доводим результат до идеала.
					</p>
					
					<div class="hero__actions">

						<a href="#contacts" class="hero__button">
							Записаться на осмотр
						</a>
						
						<p class="hero__note">
							<img src="/star.svg" alt="" class="hero__icon" />
							
							<span>
							Бесплатная консультация и оценка
						    </span>
						</p>
						
					</div>

				</div>

			</div>
		
		</section>

		<!-- Преимущества -->
		 <section class="features">
			
			<div class="container">

				<ul class="features__list">

					<!-- Преимущество 1 -->
					 <li class="features_item">
						<img src="/person_icon.svg" alt="" class="features__icon" />

						<div class="features__info">

							<h5 class="features__title">
								Без покраски и без риска
							</h5>

							<p class="features__text">
								Сохраняем родное лакокрасочное покрытие автомобиля
							</p>

						</div>
					 </li>

					<!-- Преимущество 2 -->
					 <li class="features_item">
						<img src="/shine_icon.svg" alt="" class="features__icon" />

						<div class="features__info">

							<h5 class="features__title">
								Опытные мастера
							</h5>

							<p class="features__text">
								Работаем с автомобилями много лет и постоянно повышаем квалификацию
							</p>

						</div>
					 </li>

					 <!-- Преимущество 3 -->
					 <li class="features_item">
						<img src="/target_icon.svg" alt="" class="features__icon" />

						<div class="features__info">

							<h5 class="features__title">
								Работаем на результат
							</h5>

							<p class="features__text">
								Делаем до идеала — без спешки и компромиссов по качеству
							</p>

						</div>
					 </li>

				</ul>

			</div>
		
		</section>

		<!-- Преимущества -->
		 <section id="advantages" class="advantages">



	</main>


</Layout>